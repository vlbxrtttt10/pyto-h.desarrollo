# URL de la API de Aleri (backend Laravel)
ALERI_API_URL=http://127.0.0.1:8000/api

# Credenciales de un usuario existente en Aleri (el simulador se loguea igual que el frontend)
ALERI_EMAIL=admin@aleri.mining
ALERI_PASSWORD=password

# Cada cuantos milisegundos se envia una lectura nueva
READING_INTERVAL_MS=8000

# Probabilidad (0-100) de que una lectura generada sea una falla simulada en vez de normal
FAILURE_CHANCE_PERCENT=20
